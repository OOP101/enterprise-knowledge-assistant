# ===== LLM 配置 =====
# OpenAI 兼容接口（DeepSeek / Qwen / 本地 vLLM 等）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ===== Embedding 配置 =====
# Provider: dashscope(原生) | openai(兼容) | local(本地BGE) | demo(哈希兜底)
# - dashscope: DashScope text-embedding-v3, 1024 维, 需 EMBEDDING_API_KEY
# - openai:    OpenAI 兼容接口 (SiliconFlow/Zhipu/OpenAI), 需 EMBEDDING_API_KEY
# - local:    本地 sentence-transformers BGE 模型, 离线可用, 无需 Key
# - demo:     哈希向量兜底, 无外部依赖
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-xxxxxxxx
EMBEDDING_MODEL=text-embedding-v3
# 本地模型名称（EMBEDDING_PROVIDER=local 时生效）
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# ===== 向量数据库配置 =====
# 开发阶段使用 ChromaDB
VECTOR_STORE=chroma
# CHROMA_PERSIST_DIR 默认由 config/settings.py 基于项目根目录推导（PROJECT_ROOT/vector_db）。
# 如需自定义，请填写绝对路径，避免相对路径因启动目录不同而错位。
# CHROMA_PERSIST_DIR=D:/path/to/your/vector_db
# 生产环境切换 Milvus 时启用
# VECTOR_STORE=milvus
# MILVUS_URI=http://localhost:19530
# MILVUS_COLLECTION=enterprise_knowledge

# ===== 文档分块参数 =====
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ===== 重排序配置（2.0 可插拔）=====
# demo(字符重合兜底) / qwen(在线 qwen-rerank，需 EMBEDDING_API_KEY) / bge(本地 FlagEmbedding)
RERANKER_PROVIDER=demo
RERANKER_MODEL=qwen-rerank-v1

# ===== 检索配置 =====
RETRIEVER_HYBRID=true

# ===== 记忆配置（2.0）=====
# 短期记忆对话轮数
MEMORY_K=5
# 长期记忆注入条数
LONG_MEMORY_TOP_K=3
# 是否启用 LLM 指代消解
CONDENSE_HISTORY=true

# ===== Agent 工具（2.0）=====
# 非空则真实 HTTP 调用流程引擎；留空使用 mock 演示工单
# WORKFLOW_API_BASE=http://your-workflow-service
# WORKFLOW_TIMEOUT=10

# ===== 认证 / 多知识库（2.0）=====
# 默认关闭，保证演示可直接访问；生产设为 true 并改 JWT_SECRET
AUTH_ENABLED=false
JWT_SECRET=change-me-in-prod
JWT_EXPIRE_MINUTES=720
DEFAULT_KB_ID=default
# 预置管理员（仅 auth_enabled=true 时首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== Eval 评估（2.0）=====
EVAL_TOP_K=5

# ===== v1.5 优化配置 =====
# 查询改写（LLM/规则扩展检索关键词，提升召回率）
QUERY_REWRITE=true
# 上下文压缩（Token 超预算时对分片摘要/截断）
CONTEXT_COMPRESS=true
CONTEXT_TOKEN_BUDGET=6000
# 热查询缓存（LRU，文档变更自动失效）
CACHE_ENABLED=true
CACHE_SIZE=100
CACHE_TTL=3600

# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8008
